node_modules/
.DS_Store
.cache/
*.tmp
*.tmp.*
.env
.env.*

# Backups de assets (no se sirven; solo inflan el deploy y el hash de versión).
*.bak
.*-bak/

# Panel admin / editor de jugadores (playeredit) y su tooling de retratos:
# viven solo en local y NUNCA se publican en GitHub. El juego funciona sin esto;
# el admin solo está disponible en local vía `npm run serve`.
local/

# Contador global de partidas: lo escribe el servidor en producción y debe
# sobrevivir a los deploys (si estuviera versionado, cada push lo resetearía).
data/stats.json

# Rankings semanales (un JSON por semana ISO): estado de runtime que el servidor
# escribe y archiva. No se versiona, por la misma razón que stats.json.
data/semanal/
